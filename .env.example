# Names only. Values live in Vercel → fomo-overtime → Settings → Environment Variables.
APP_URL=https://fomo-overtime.vercel.app
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_OVERTIME_CHANNEL_ID=C06J9KBAAGG
# Same value as the bookings board project (Firestore "fomo-bookings-board-v2"; this app uses ot_* collections only)
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Service account with domain-wide delegation for Google Calendar (see docs/SETUP.md)
GOOGLE_CALENDAR_SA_BASE64=
# Admin page sign-in (Google OAuth client; add APP_URL/api/auth/callback/google as a redirect URI)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_WORKSPACE_DOMAIN=fomorentals.co.uk
# Vercel sends this to the cron route
CRON_SECRET=
SENTRY_DSN=
# Optional: calendar event location
OVERTIME_LOCATION=FOMO Rentals
